# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- AI (set ONE; provider auto-detected) ----------
# FREE options (recommended):
#   Gemini  -> get a free key at https://aistudio.google.com/apikey  (no card, ~1500 req/day)
GEMINI_API_KEY=
#   Groq    -> get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Paid options:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: force a provider ("gemini" | "groq" | "anthropic" | "openai")
AI_PROVIDER=

# ---------- Email (optional, free) ----------
# Resend free key: https://resend.com/api-keys  (test sends to your own email via onboarding@resend.dev)
RESEND_API_KEY=
EMAIL_FROM=MNB Cortex <onboarding@resend.dev>

# ---------- Signing secrets (long random strings; never reuse another secret) ----------
# Authorises Vercel's scheduled calls to /api/cron/* (sent as a Bearer token). Without it the crons refuse to run.
CRON_SECRET=
# Seals stored integration credentials (AES-GCM, src/lib/crypto.ts). At least 16 characters; changing it makes saved credentials unreadable.
ENCRYPTION_KEY=
# Verifies Resend delivery-event webhooks (Svix signature) at /api/email/events.
RESEND_WEBHOOK_SECRET=
# Signs one-tap approve/reject links in decision emails (falls back to LINK_SIGNING_SECRET, then CRON_SECRET).
APPROVAL_SIGNING_SECRET=
# Signs unsubscribe links in product emails; CRON_SECRET is still accepted for links already sent.
LINK_SIGNING_SECRET=

# ---------- Operators and notifications ----------
# Comma-separated platform super-admin emails (only effective once the address is verified at sign-in).
SUPER_ADMIN_EMAILS=
# Default operator inbox for lead and access-request notifications.
ADMIN_EMAIL=
# Where operator alerts (payments, cron, collections incidents) are emailed; defaults to ADMIN_EMAIL.
OPS_NOTIFY_EMAIL=
# Where pricing/health-check lead notifications go; defaults to ADMIN_EMAIL.
LEAD_NOTIFY_EMAIL=

# ---------- App URL and email addresses ----------
# Base URL for the activation link in super-admin "provision customer" emails (default https://cortex.mnbresearch.com).
APP_URL=
# Sender address for branded product email (shown as "MNB Cortex by MNB Research").
EMAIL_FROM_ADDRESS=
# Reply-To for branded product email (a monitored mailbox).
EMAIL_REPLY_TO=
# Relay sender for collections reminders when a workspace has not connected its own domain.
COLLECTIONS_FROM_ADDRESS=
# From header for the weekly update and weekly plan emails; defaults to the branded sender.
WEEKLY_FROM=

# ---------- AI model overrides (optional; defaults live in src/lib/ai/model-defaults.ts) ----------
# Override the OpenAI chat model.
OPENAI_MODEL=
# Override the OpenAI model used for AI-visibility checks; defaults to OPENAI_MODEL.
OPENAI_VISIBILITY_MODEL=
# Override the Anthropic model.
ANTHROPIC_MODEL=
# Override the Groq model.
GROQ_MODEL=
# Veo video resolution: 720p (default) or 1080p — 1080p costs more per clip.
VEO_RESOLUTION=

# ---------- Public (exposed to the browser) ----------
# Google OAuth client id for the "Sign in with Google" button; the button is hidden when unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# WhatsApp number (country code, digits only) used for the public contact links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------- Payments: Cashfree ----------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "production" (default) or "sandbox".
CASHFREE_ENV=

# ---------- WhatsApp Cloud API (platform/operator sends only; workspaces use their own number) ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Scheduled email switches ----------
# Weekly product-update email: sent on Mondays only when set to 1.
WEEKLY_UPDATE_ENABLED=
# Weekly plan email: on unless set to 0.
WEEKLY_PLAN_ENABLED=
# Abandoned-checkout follow-up: "off" is a hard kill that overrides the mode set in the operator console.
CHECKOUT_FOLLOWUP_MODE=

# ---------- More model pins (optional; unset = the defaults in src/lib/ai) ----------
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
VEO_MODEL=

# ---------- Public app URL (browser-visible; default https://cortex.mnbresearch.com) ----------
NEXT_PUBLIC_APP_URL=
