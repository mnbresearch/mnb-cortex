{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/autopilot",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/priority",
      "schedule": "30 4 * * *"
    }
  ]
}
