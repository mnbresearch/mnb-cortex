/*
  "LIVE" MEANT "WE SAVED IT WITHOUT COMPLAINING".

  WHAT WAS WRONG

  api/integrations/route.ts verifies credentials before storing them, which is
  right, and testCredentials() has a real API call for 18 of the 63 catalogue
  providers. For the other 45 it ended at:

      default: return { ok: true, message: "Saved securely. This provider has
               no automated test — verify from its dashboard." };

  The MESSAGE is honest. The boolean is not, and the boolean is what everything
  downstream reads:

    - the row is stored with `status: "connected"` and `last_test_ok: true`,
      so a credential nobody checked is recorded as a credential that passed;
    - integrations-manager.tsx renders `status === "connected"` as a green
      tick and the word **Live**;
    - pressing **Test** returns `ok: true` and paints the same tick, so the
      one control whose entire job is to answer "is this working?" answers yes
      without asking anyone.

  A customer who fat-fingers a WooCommerce consumer secret is told it is Live,
  by a product whose whole promise is that it notices things before they cost
  you money. And it is our own claim too: "62 integrations" reads very
  differently if a fifth of them can be confirmed and the rest cannot.

  WHY A THIRD STATE RATHER THAN REFUSING TO SAVE

  Refusing an untestable provider would be worse — most of those 45 have no
  cheap authenticated endpoint to probe, and the credential is still perfectly
  usable. The honest model is three states, not two:

      connected → we made a real call and the provider accepted it
      saved     → we stored it; we have not verified it, and we say so
      error     → we made a real call and the provider rejected it

  `saved` is the state that did not exist, which is why 45 providers had to
  borrow `connected`.

  Pure and dependency-free so scripts/test-integration-status.mjs can execute
  it — the badge a customer trusts should not be the one thing with no test.
*/

/** What the stored `integrations.status` column may hold. */
export type ConnStatus = "connected" | "saved" | "error";

/**
 * The status to persist after an attempt.
 *
 * `verified` is the new input. It answers "did a real API call happen", which
 * is a different question from `ok` ("did anything object"), and conflating the
 * two is the entire bug.
 */
export function statusFor(ok: boolean, verified: boolean): ConnStatus {
  if (!ok) return "error";
  return verified ? "connected" : "saved";
}

/**
 * What to record in `config.last_test_ok`.
 *
 * `null`, not `false`, when nothing was tested. `false` would assert the test
 * ran and failed — a second untrue claim in place of the first. Null is the
 * only value that means "no test happened", and it is what `saved` implies.
 */
export function lastTestOk(ok: boolean, verified: boolean): boolean | null {
  return verified ? ok : null;
}

export type Badge = {
  label: string;
  /** ok = green, neutral = informational, warn = needs attention. */
  tone: "ok" | "neutral" | "warn";
  /** Plain sentence for the title/aria — the badge alone cannot carry this. */
  hint: string;
};

/** How a stored status is presented. The only place that decides this. */
export function badgeFor(status: string | null | undefined): Badge {
  switch (status) {
    case "connected":
      return {
        label: "Live",
        tone: "ok",
        hint: "Verified — we made a real API call and this provider accepted the credentials.",
      };
    case "error":
      return {
        label: "Check",
        tone: "warn",
        /*
          "COULD NOT VERIFY", NOT "THE PROVIDER REJECTED".

          This said "The provider rejected these credentials the last time we
          tried. Reconnect them." — which asserts a cause this state does not
          establish. `error` is also reached when our own SSRF guard refuses a
          customer-supplied URL, and (until the fix in the route) was reached
          on any network failure, so the badge was telling people to rotate a
          working credential because Meta had a bad five minutes.

          The wording now covers every way verification can fail without
          claiming to know which one happened. The specific reason is in the
          message the Test button returns, where it belongs.
        */
        hint: "We could not verify these credentials the last time we tried. Open the provider and check them, then press Test.",
      };
    case "saved":
      return {
        label: "Saved",
        tone: "neutral",
        hint: "Stored securely, but not verified — this provider has no endpoint we can safely test against. Confirm it from the provider's own dashboard.",
      };
    default:
      /*
        An unknown value is treated as unverified rather than as working. Rows
        written before this change hold "connected" for providers that were
        never tested, so they keep their green badge until the next connect or
        Test — a wrong green on an existing row is not worth a migration, but
        defaulting a NEW unknown to green would reintroduce the bug.
      */
      return {
        label: "Saved",
        tone: "neutral",
        hint: "Stored, but we have not verified these credentials.",
      };
  }
}

/** Is this status one the customer should act on? */
export function needsAttention(status: string | null | undefined): boolean {
  return status === "error";
}

/**
 * Should a test result be WRITTEN to the row at all?
 *
 * No, when we never reached the provider. A DNS failure, an egress block or a
 * provider outage tells you nothing about the credential — so overwriting a
 * verified `connected` row with `error` because Meta was briefly unreachable
 * replaces a true fact with a false one, and (via badgeFor) advises the
 * customer to go and rotate a key that works.
 *
 * The previous code had no way to express this: testCredentials' catch
 * returned `verified: true`, which is how a network error came to be recorded
 * as a rejection.
 */
export function shouldPersistResult(unreachable?: boolean): boolean {
  return !unreachable;
}

/**
 * The status to store on CONNECT, where the row must be written regardless.
 *
 * Pressing Test during an outage can simply decline to write (see above), but
 * connecting cannot: the customer has just handed over a credential and it has
 * to be saved. So the question becomes which status a credential we could not
 * reach deserves — and it is `saved`, not `error`.
 *
 * statusFor() alone answers "error" here, because it is given ok:false and
 * treats a negative as a rejection. That rule is right for its two inputs and
 * wrong for this third one: "the provider said no" and "we could not ask" are
 * the two things this whole module exists to separate, and an outage during
 * signup must not brand a good credential as broken on the integrations page.
 */
export function statusForAttempt(ok: boolean, verified: boolean, unreachable?: boolean): ConnStatus {
  if (unreachable) return "saved";
  return statusFor(ok, verified);
}
